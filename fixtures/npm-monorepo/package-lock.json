      "integrity": "sha512-hlq8tAfn0m/61p4BVRcPzIGr6LKiMwo4VM6dGi6pt4qcRkmNzTcWq6eCEjEh+qXjkMDvPlOFFSGwQjoEa6gyMA==",
      "license": "ISC",
      "bin": {
        "semver": "bin/semver.js"
      },
      "engines": {
        "node": ">=10"
      }
    },
    "packages/app-a": {
      "name": "@fixture/app-a",
      "dependencies": {
        "semver": "7.7.1"
      }
    },
    "packages/app-b": {
      "name": "@fixture/app-b",
      "dependencies": {
        "semver": "6.3.1"
      }
    },
    "packages/app-b/node_modules/semver": {
